# ===================================================================
# 3D REEL STUDIO — Backend Environment Configuration Template
# Phase 15: Production Deployment
# ===================================================================

ENVIRONMENT=development
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
DOCS_ENABLED=true
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=sqlite:///data/studio.db
DATA_DIR=data

STORAGE_DIR=storage
MEDIA_STORAGE_ROOT=storage
TEMP_STORAGE_ROOT=storage/temp

MAX_UPLOAD_SIZE=104857600
SOURCE_VIDEO_MAX_SIZE_MB=500
FACE_REFERENCE_MAX_SIZE_MB=25
MAX_VIDEO_DURATION=600.0
SOURCE_VIDEO_MAX_DURATION_SECONDS=600.0
SOURCE_VIDEO_MAX_WIDTH=3840
SOURCE_VIDEO_MAX_HEIGHT=3840
SOURCE_VIDEO_MAX_FPS=120.0
MAX_SCENE_COUNT_LIMIT=100

PROCESSING_TIMEOUT=300
FFMPEG_TIMEOUT_SECONDS=180
TRANSCRIPTION_TIMEOUT_SECONDS=60
COMIC_GENERATION_TIMEOUT_SECONDS=60
SEGMENTATION_TIMEOUT_SECONDS=60
RENDER_TIMEOUT_SECONDS=300
MAX_CONCURRENT_RENDERS=2
RATE_LIMIT_REQUESTS_PER_MINUTE=60

FFMPEG_PATH=ffmpeg

OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=whisper-1

COMIC_GENERATION_PROVIDER=openai
COMIC_GENERATION_MODEL=dall-e-3
COMIC_GENERATION_API_KEY=

SEGMENTATION_PROVIDER=opencv_guided
SEGMENTATION_MODEL=grabcut_pose_prior
SEGMENTATION_DEFAULT_BG_MODE=ORIGINAL

FRONTEND_URL=http://localhost:8080
CORS_ORIGINS=["*"]
CORS_ALLOWED_ORIGINS=["*"]
