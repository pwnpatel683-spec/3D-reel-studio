# ===================================================================
# 3D REEL STUDIO — Production Git Ignore Rules
# Protects secrets, credentials, databases, media, and build caches
# ===================================================================

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.env
*.secret
*.secrets
*.key
*.pem
*.crt
*.cert
credentials.json
service_account.json

# SQLite Database & Data Dumps
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
data/
backend/data/*.db
backend/data/*.sqlite
backend/data/*.sqlite3

# Media Storage & Ephemeral Uploads
storage/
backend/storage/
temp/
tmp/
*.mp4
*.mp3
*.wav
*.m4a
*.png
*.jpg
*.jpeg
*.webp
*.gif
!tests/fixtures/*.png
!tests/fixtures/*.jpg

# Python Cache & Bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Pytest & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover
*.log

# Frontend & Build Tools
node_modules/
dist/
.parcel-cache/
.cache/

# IDE & OS Artifacts
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
Desktop.ini
